DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# Database: sqlite for local, mysql for production
DB_ENGINE=sqlite
# DB_ENGINE=mysql
DB_NAME=papermind
DB_USER=papermind
DB_PASSWORD=papermind123
DB_HOST=127.0.0.1
DB_PORT=3306

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# NewAPI / OpenAI-compatible LLM gateway (e.g. TalkWeb)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://llm.talkweb.com.cn
DEEPSEEK_MODEL=deepseek-v4-flash

# OCR: paddleocr service URL (docker compose service)
OCR_SERVICE_URL=http://127.0.0.1:8866
OCR_PROVIDER=paddleocr

# MinerU layout parser (optional). Start with: mineru-api --host 0.0.0.0 --port 8001
MINERU_API_URL=http://127.0.0.1:8001

MEDIA_ROOT=/app/media
LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai
